# /etc/tradeforce.env - what the pool agent reads. Copy, fill in, chmod 600.
#
# This file is the only secret on a pool box. Everything else here can be
# rebuilt from this repository; these three values cannot, so write down where
# each one comes from before you need it at 2am.

# Supabase: Project Settings -> API. The SERVICE ROLE key, not the anon key -
# the agent writes snapshots and reads sealed credentials, both of which RLS
# denies to anon.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The AES-256-GCM key (32 bytes, base64) that the website's sealSecret() used to
# encrypt every stored MT5 password and EA key.
#
# COPY IT FROM VERCEL: project -> Settings -> Environment Variables ->
# MT5_CRED_KEY, Production. DO NOT GENERATE A NEW ONE. A fresh key does not
# fail loudly - it decrypts nothing, and every trader has to re-enter their MT5
# password on the Connect page, because only the website can re-seal them.
#
# `python3 tf_agent.py --selftest` round-trips this key and is the go/no-go
# check that you pasted the right one.
MT5_CRED_KEY=

# Which terminal image to run. tf-mt5:ntsync is the one built by
# ../mt5-image/Dockerfile.ntsync - Wine with ntsync compiled in, which is ~3x
# less CPU per terminal. Changing this tag makes the agent rebuild every
# terminal, one per poll, onto a new shared prefix.
TF_IMAGE=tf-mt5:ntsync

# The name this box claims work under, matched against mt5_instances.server_host.
# Deliberately set rather than left to the machine's hostname: a replacement box
# with this name adopts the rows the old one owned and rebuilds them from the
# stored credentials, with nothing for the trader to do. Contabo names its
# machines vmi<digits>, which would strand every existing row.
TF_HOST=contabo-1

# 30 fits a 12-core box at ~0.116 cores per terminal. A claim is also gated on
# CPU pressure, so this is a ceiling, not a promise.
TF_CAPACITY=30
TF_PRESSURE_CEILING=70

# Which hosted EAs exchange files instead of web requests: off | all | <ids>.
# "all" is what production runs: Vercel's DDoS mitigation blocks a pool box's
# address for 31 minutes at a time, and a blocked EA cannot be told its rules
# changed.
TF_BRIDGE=all

# Where the website lives, for the links in trader-facing events.
TF_SITE_URL=https://trade-force-rouge.vercel.app
