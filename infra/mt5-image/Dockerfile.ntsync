FROM tf-mt5:current

# Wine 11.0, built from official source WITH ntsync ("inproc sync"): Windows
# waits become direct ioctls on /dev/ntsync instead of a writev/read round trip
# to wineserver. That round trip is where a hosted terminal's CPU went - 89%
# kernel time, and the top contended lock was wineserver's own epoll set.
# WineHQ's packages (stable and staging alike) are built with it disabled.
#
# Installed alongside the packaged Wine and symlinked over it, so every launcher
# path in the base image keeps working. Wine resolves its libdir from
# /proc/self/exe, so the symlink is harmless.
COPY wine-ntsync.tar /tmp/wine-ntsync.tar
RUN set -eux; \
    tar -C /opt -xf /tmp/wine-ntsync.tar; \
    rm -f /tmp/wine-ntsync.tar; \
    rm -rf /opt/wine-stable; \
    ln -sfn /opt/wine-ntsync /opt/wine-stable; \
    /opt/wine-stable/bin/wine --version

# Wine prompts for wine-mono the first time it touches a prefix it has to
# upgrade, and that prompt is MODAL: on the image's own entrypoint the terminal
# never starts behind it. MetaTrader is native code and needs no .NET, so
# disable the two components Wine would offer to download. mt5-prefix.tgz is
# baked under this same Wine, which is the real fix; this is the belt to that
# pair of braces, for any prefix that still arrives needing an upgrade.
ENV WINEDLLOVERRIDES="mscoree,mshtml=d"
